<Window x:Class="WpfApp4.MyDocumentViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp4"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="MyDocumentViewer"
        Height="450" Width="1000"
        WindowStartupLocation="CenterOwner">

    <!-- 自訂路由命令透過 CommandBinding 呼叫 RichTextBox 的編輯功能。
         與內建 ApplicationCommands 分開，避免命令處理函式遞迴呼叫自己。 -->
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MyDocumentViewer.CopyCommand}"
                        CanExecute="CopyCommand_CanExecute"
                        Executed="CopyCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MyDocumentViewer.CutCommand}"
                        CanExecute="CutCommand_CanExecute"
                        Executed="CutCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MyDocumentViewer.PasteCommand}"
                        CanExecute="PasteCommand_CanExecute"
                        Executed="PasteCommand_Executed"/>
    </Window.CommandBindings>

    <Window.Resources>
        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style x:Key="FormatButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Height="44" Width="210"
                     Band="0" BandIndex="0" Background="#FFFDE7">
                <Button Content="複製" ToolTip="複製（Ctrl+C）"
                        Style="{StaticResource EditButtonStyle}"
                        Command="{x:Static local:MyDocumentViewer.CopyCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                <Button Content="剪下" ToolTip="剪下（Ctrl+X）"
                        Style="{StaticResource EditButtonStyle}"
                        Command="{x:Static local:MyDocumentViewer.CutCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                <Button Content="貼上" ToolTip="貼上（Ctrl+V）"
                        Style="{StaticResource EditButtonStyle}"
                        Command="{x:Static local:MyDocumentViewer.PasteCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
            </ToolBar>

            <ToolBar x:Name="EditingToolBar"
                     Height="44" Width="740"
                     Band="0" BandIndex="1" Background="#FFEEDD">
                <ToggleButton x:Name="BoldButton"
                              Style="{StaticResource FormatButtonStyle}"
                              ToolTip="粗體（Ctrl+B）"
                              Command="EditingCommands.ToggleBold"
                              CommandTarget="{Binding ElementName=MainRichTextBox}">
                    <TextBlock Text="B" FontFamily="Times New Roman"
                               FontSize="28" FontWeight="Bold"/>
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton"
                              Style="{StaticResource FormatButtonStyle}"
                              ToolTip="斜體（Ctrl+I）"
                              Command="EditingCommands.ToggleItalic"
                              CommandTarget="{Binding ElementName=MainRichTextBox}">
                    <TextBlock Text="I" FontFamily="Times New Roman"
                               FontSize="28" FontStyle="Italic"/>
                </ToggleButton>
                <ToggleButton x:Name="UnderlineButton"
                              Style="{StaticResource FormatButtonStyle}"
                              ToolTip="底線（Ctrl+U）"
                              Command="EditingCommands.ToggleUnderline"
                              CommandTarget="{Binding ElementName=MainRichTextBox}">
                    <TextBlock Text="U" FontFamily="Arial"
                               FontSize="26" TextDecorations="Underline"/>
                </ToggleButton>

                <xctk:ColorPicker x:Name="FontColorPicker"
                                  Width="160" Height="38"
                                  ToolTip="文字顏色"
                                  SelectedColorChanged="FontColorPicker_SelectedColorChanged"/>
                <ComboBox x:Name="FontFamilyComboBox"
                          Width="150" Height="38" Margin="5,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalContentAlignment="Center"
                          DisplayMemberPath="Source"
                          ToolTip="字型"
                          SelectionChanged="FontFamilyComboBox_SelectionChanged"/>
                <ComboBox x:Name="FontSizeComboBox"
                          Width="150" Height="38" Margin="5,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalContentAlignment="Center"
                          ToolTip="字級（WPF 單位）"
                          SelectionChanged="FontSizeComboBox_SelectionChanged"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar Height="30" DockPanel.Dock="Bottom" Background="LightGray">
            <StatusBarItem>
                <TextBlock Text="就緒"/>
            </StatusBarItem>
        </StatusBar>

        <RichTextBox x:Name="MainRichTextBox"
                     Background="#FFEFEFEC" BorderThickness="0"
                     AcceptsTab="True"
                     IsInactiveSelectionHighlightEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     SelectionChanged="MainRichTextBox_SelectionChanged">
            <FlowDocument FontFamily="Microsoft JhengHei" FontSize="16">
                <Paragraph/>
            </FlowDocument>
        </RichTextBox>
    </DockPanel>
</Window>
